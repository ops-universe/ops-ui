import type {ReactNode,ReactElement,ButtonHTMLAttributes,AnchorHTMLAttributes} from 'react';
export type Theme='system'|'light'|'dark';
export type Link={href:string;label:string;current?:boolean};
export type PaletteTokens=Record<'bg'|'surface'|'text'|'muted'|'accent'|'border'|'ink',string>;
export const palettes:Record<string,{light:PaletteTokens;dark:PaletteTokens}>;
export function resolvePalette(project?:string):string;
export function paletteStyle(project?:string):Record<string,string>;
export function ThemeProvider(p:{children?:ReactNode;initial?:Theme;project?:string}):ReactElement;
export function ThemeToggle():ReactElement;
export function Button(p:((ButtonHTMLAttributes<HTMLButtonElement>&{href?:never})|(AnchorHTMLAttributes<HTMLAnchorElement>&{href:string}))&{variant?:'primary'|'secondary'}):ReactElement;
export function Header(p:{brand?:string;home?:string;links?:Link[];children?:ReactNode}):ReactElement;
export function Hero(p:{eyebrow?:string;title:ReactNode;description?:ReactNode;actions?:ReactNode;visual?:ReactNode;animate?:boolean}):ReactElement;
export function Card(p:{title:ReactNode;children?:ReactNode}):ReactElement;
export function Footer(p:{brand?:string;links?:Link[];description?:ReactNode;children?:ReactNode}):ReactElement;
export type SearchEntry={title:string;href:string;description?:string;keywords?:string[]};
export function searchEntries(entries:SearchEntry[],query:string):SearchEntry[];
export function SearchDialog(p:{entries?:SearchEntry[];label?:string}):ReactElement;
export function MobileNavigation(p:{links?:Link[];label?:string}):ReactElement;
export function FeatureCard(p:{title:string;description?:ReactNode;icon?:ReactNode;href?:string;children?:ReactNode}):ReactElement;
export function CodeBlock(p:{code?:string;language?:string}):ReactElement;
export function Terminal(p:{title?:string;lines?:string[]}):ReactElement;
export function Steps(p:{items?:{title:string;description?:string}[]}):ReactElement;
export function DocsLayout(p:{links?:Link[];children?:ReactNode}):ReactElement;
